; Shared helpers for exhaustive/stratified tests.
(library
 (name test_tree_helpers)
 (modules test_tree_helpers)
 (libraries sosie))

; Bounded exhaustive tests: all tree pairs up to size 5.
; Run with: dune build @exhaustive
(executable
 (name test_exhaustive)
 (modules test_exhaustive)
 (libraries sosie test_tree_helpers))

(rule
 (alias exhaustive)
 (action (run ./test_exhaustive.exe)))

; Stratified random tests: 7 shape classes, sizes 100-5000.
; Run with: dune build @stratified
(executable
 (name test_stratified)
 (modules test_stratified)
 (libraries sosie test_tree_helpers unix))

(rule
 (alias stratified)
 (action (run ./test_stratified.exe)))

; Integration tests: require Chromium, not run by default.
; Run with: dune build @integration
(executable
 (name test_cdp_integration)
 (modules test_cdp_integration)
 (libraries sosie alcotest))

(executable
 (name test_capture_integration)
 (modules test_capture_integration)
 (libraries sosie alcotest))

(executable
 (name test_round_trip)
 (modules test_round_trip)
 (libraries sosie alcotest base64 qcheck-core qcheck-alcotest))

(rule
 (alias integration)
 (action (progn
  (run ./test_cdp_integration.exe)
  (run ./test_capture_integration.exe)
  (run ./test_round_trip.exe))))
